  },
  {
    "id": "l504",
    "member_id": "",
    "room": "tavern",
    "text": "大家一起乾杯！",
    "is_demo": true
  },
  {
    "id": "l505",
    "member_id": "",
    "room": "training",
    "text": "稻草人今天又被打歪了。",
    "is_demo": true
  },
  {
    "id": "l506",
    "member_id": "",
    "room": "training",
    "text": "射箭要先穩住呼吸。",
