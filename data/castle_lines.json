  },
  {
    "id": "l025",
    "member_id": "",
    "room": "music",
    "text": "剛剛那段合奏好好聽！",
    "is_demo": true
  },
  {
    "id": "l026",
    "member_id": "m01",
    "room": "",
    "text": "大家都到了嗎？等等開會喔。",
    "is_demo": true
  },
  {
    "id": "l027",
    "member_id": "m01",
    "room": "",
    "text": "看到大家還在，就覺得很開心。",
    "is_demo": true
  },
  {
    "id": "l028",
    "member_id": "m02",
    "room": "",
    "text": "有什麼事都可以找我。",
    "is_demo": true
  },
  {
    "id": "l501",
    "member_id": "",
    "room": "tavern",
    "text": "老闆，再來一杯蘋果酒！",
